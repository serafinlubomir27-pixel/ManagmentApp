{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nodus-api",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-m", "uvicorn", "backend.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "port": 8000
    },
    {
      "name": "nodus-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "logo-preview",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-m", "http.server", "7788", "--directory", "docs"],
      "port": 7788
    }
  ]
}
